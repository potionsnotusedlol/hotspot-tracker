#!/usr/bin/env bash
# Fast checks before every commit. Enable once per clone: git config core.hooksPath .githooks
# Bypass only if you are sure: git commit --no-verify
set -euo pipefail

root=$(git rev-parse --show-toplevel)
failed=0

# The same repository rules as in CI, applied to the staged changes
if ! bash "$root/ops/ci/check-repo-rules.sh" --staged; then
  failed=1
fi

# Secrets. gitleaks is used when installed; otherwise common token formats are matched.
if command -v gitleaks > /dev/null 2>&1; then
  if ! gitleaks git --pre-commit --staged --redact --no-banner; then
    failed=1
  fi
else
  patterns=(
    '[0-9]{8,10}:[A-Za-z0-9_-]{35}'             # Telegram bot token
    '-----BEGIN [A-Z ]*PRIVATE KEY-----'        # private key
    'gh[pousr]_[A-Za-z0-9]{36,}'                # GitHub token
    'github_pat_[A-Za-z0-9_]{40,}'              # GitHub fine-grained token
    'AKIA[0-9A-Z]{16}'                          # AWS access key
    'AIza[0-9A-Za-z_-]{35}'                     # Google API key
    'sk-(ant-|proj-)?[A-Za-z0-9_-]{32,}'        # LLM provider API key
  )
  added=$(git diff --cached -U0 --no-color | grep -E '^\+[^+]' || true)
  for pattern in "${patterns[@]}"; do
    if grep -qE -- "$pattern" <<< "$added"; then
      echo "Possible secret in the staged changes (pattern: $pattern)."
      echo "Move it to an environment variable; if it is not a secret, commit with --no-verify."
      failed=1
    fi
  done
fi

if [ "$failed" -ne 0 ]; then
  echo "Commit rejected. See the messages above."
fi
exit "$failed"
