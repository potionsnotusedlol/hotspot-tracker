root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,html,css,js}]
indent_size = 2

[*.md]
# Two trailing spaces mean a line break in Markdown
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.csv]
# Data and fixtures are kept as is
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
