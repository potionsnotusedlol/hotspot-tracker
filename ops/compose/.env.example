# Copy this file to ops/compose/.env and set real passwords. .env is ignored by git.

POSTGRES_DB=hotspot
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me

# Used by Flyway migrations (DDL allowed)
DB_MIGRATION_USER=hotspot_migrator
DB_MIGRATION_PASSWORD=change-me

# Used by the application at runtime (DML only)
DB_APP_USER=hotspot_app
DB_APP_PASSWORD=change-me

# Host ports (bound to 127.0.0.1); change them if they are already taken.
# PostgreSQL uses 5433 so it does not clash with a locally installed PostgreSQL on 5432.
POSTGRES_PORT=5433
REDIS_PORT=6379
